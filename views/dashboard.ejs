<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard — LinkSnap</title>
    <meta name="description" content="Manage and track all your shortened links from the LinkSnap dashboard.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #000000; --bg2: rgba(255,255,255,0.02); --card: rgba(255,255,255,.03); --border: rgba(255,255,255,.05);
            --primary: #3b82f6; --primary-l: #60a5fa; --accent: #00ff00;
            --text: #ffffff; --muted: #a0a0a0; --danger: #ef4444;
            --gradient: linear-gradient(45deg, #3b82f6, #06b6d4);
            --success: #10b981; --warn: #f59e0b;
            --topbar-bg: rgba(0,0,0,.6);
            --modal-bg: rgba(20,20,25,.95); --modal-overlay: rgba(0,0,0,.8);
            --input-bg: rgba(255,255,255,.03); --input-focus-bg: rgba(59,130,246,.07);
            --select-bg: #000000;
            --toast-bg: #111116;
            --api-box-bg: rgba(0,0,0,.5);
            --tag-cat-bg: rgba(59,130,246,.15); --tag-pw-bg: rgba(245,158,11,.12); --tag-exp-bg: rgba(239,68,68,.1);
            --tag-pw-color: #fbbf24; --tag-exp-color: #fca5a5;
            --danger-btn-bg: rgba(239,68,68,.1); --danger-btn-color: #fca5a5; --danger-btn-border: rgba(239,68,68,.2);
            --btn-ghost-hover-bg: rgba(255,255,255,.05);
        }

        [data-theme="light"] {
            --bg: #fafbfc; --bg2: #ffffff; --card: rgba(255,255,255,.7); --border: rgba(0,0,0,.08);
            --primary: #7c3aed; --primary-l: #7c3aed; --accent: #06b6d4;
            --text: #1a1a2e; --muted: #6b7280; --danger: #ef4444;
            --gradient: linear-gradient(135deg, #7c3aed, #06b6d4);
            --success: #10b981; --warn: #f59e0b;
            --topbar-bg: rgba(255,255,255,.85);
            --modal-bg: #ffffff; --modal-overlay: rgba(0,0,0,.3);
            --input-bg: rgba(0,0,0,.02); --input-focus-bg: rgba(124,58,237,.04);
            --select-bg: #f3f4f6;
            --toast-bg: #ffffff;
            --api-box-bg: rgba(0,0,0,.03);
            --tag-cat-bg: rgba(124,58,237,.08); --tag-pw-bg: rgba(245,158,11,.08); --tag-exp-bg: rgba(239,68,68,.06);
            --tag-pw-color: #d97706; --tag-exp-color: #dc2626;
            --danger-btn-bg: rgba(239,68,68,.06); --danger-btn-color: #dc2626; --danger-btn-border: rgba(239,68,68,.15);
            --btn-ghost-hover-bg: rgba(0,0,0,.04);
        }

        [data-theme="light"] .sidebar { box-shadow: 2px 0 20px rgba(0,0,0,.04); }
        [data-theme="light"] .stat-card { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        [data-theme="light"] .url-card { box-shadow: 0 2px 8px rgba(0,0,0,.03); }
        [data-theme="light"] .shorten-card { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        [data-theme="light"] .modal { box-shadow: 0 20px 60px rgba(0,0,0,.15); }
        [data-theme="light"] .toast { box-shadow: 0 8px 30px rgba(0,0,0,.1); border-color: var(--border); }
        [data-theme="light"] input::placeholder { color: #9ca3af; }
        [data-theme="light"] .search-box::placeholder { color: #9ca3af; }
        [data-theme="light"] .spinner { border-color: rgba(0,0,0,.1); border-top-color: var(--primary); }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

        /* Sidebar */
        .sidebar {
            width: 240px; flex-shrink: 0; background: var(--bg2); border-right: 1px solid var(--border);
            display: flex; flex-direction: column; min-height: 100vh; position: sticky; top: 0; height: 100vh;
        }
        .sidebar-logo { padding: 1.5rem; border-bottom: 1px solid var(--border); }
        .logo-text { font-size: 1.3rem; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .sidebar-nav { padding: 1rem .75rem; flex: 1; }
        .nav-item {
            display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; border-radius: 10px;
            color: var(--muted); cursor: pointer; transition: all .2s; text-decoration: none; margin-bottom: .25rem;
            font-size: .9rem; font-weight: 500; border: none; background: none; width: 100%; text-align: left;
        }
        .nav-item:hover, .nav-item.active { background: rgba(124,58,237,.15); color: var(--primary-l); }
        .nav-item .icon { font-size: 1.1rem; width: 20px; text-align: center; }
        .sidebar-footer { padding: 1rem .75rem; border-top: 1px solid var(--border); }
        .user-pill {
            display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem;
            background: var(--card); border-radius: 10px; border: 1px solid var(--border);
        }
        .avatar {
            width: 34px; height: 34px; border-radius: 50%; background: var(--gradient);
            display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .9rem; flex-shrink: 0;
        }
        .user-info .name { font-size: .9rem; font-weight: 600; }
        .user-info .email { font-size: .75rem; color: var(--muted); }

        /* Main */
        .main { flex: 1; min-width: 0; overflow-y: auto; }
        .topbar {
            position: sticky; top: 0; z-index: 50;
            padding: 1rem 2rem; background: var(--topbar-bg); backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
        }
        .topbar h1 { font-size: 1.25rem; font-weight: 700; }
        .topbar-actions { display: flex; gap: .75rem; align-items: center; }

        .btn { display: inline-flex; align-items: center; gap: .5rem; padding: .6rem 1.3rem; border-radius: 10px; font-weight: 600; font-size: .875rem; cursor: pointer; text-decoration: none; transition: all .2s; border: none; font-family: inherit; }
        .btn-primary { background: var(--gradient); color: #fff; box-shadow: 0 4px 15px rgba(124,58,237,.3); }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 25px rgba(124,58,237,.5); }
        .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
        .btn-ghost:hover { background: var(--btn-ghost-hover-bg); border-color: var(--primary-l); }
        .btn-danger { background: var(--danger-btn-bg); color: var(--danger-btn-color); border: 1px solid var(--danger-btn-border); }
        .btn-danger:hover { opacity: .85; }
        .btn-sm { padding: .4rem .9rem; font-size: .8rem; }

        /* Content */
        .content { padding: 2rem; }
        .panel { display: none; }
        .panel.active { display: block; }

        /* Stats row */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card {
            background: var(--card); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem;
            transition: all .3s ease; position: relative; overflow: hidden;
        }
        
        .stat-card::before, .url-card::before, .shorten-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            border-radius: inherit; padding: 1px;
            background: linear-gradient(45deg, transparent, rgba(59, 130, 246, 0), transparent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude;
            opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: 0;
        }
        
        .stat-card:hover::before, .url-card:hover::before, .shorten-card:hover::before {
            opacity: 1; animation: adminGlow 2s ease-in-out infinite;
        }

        .stat-card::after, .url-card::after, .shorten-card::after {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
            opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: 0;
        }
        
        .stat-card:hover::after, .url-card:hover::after, .shorten-card:hover::after { opacity: 1; }

        @keyframes adminGlow {
            0% { background: linear-gradient(45deg, transparent, rgba(59, 130, 246, 0.3), transparent); }
            50% { background: linear-gradient(45deg, transparent, rgba(59, 130, 246, 0.3), transparent); }
            100% { background: linear-gradient(45deg, transparent, rgba(59, 130, 246, 0), transparent); }
        }

        /* Suppress effects on light theme */
        [data-theme="light"] .stat-card::before, [data-theme="light"] .url-card::before, [data-theme="light"] .shorten-card::before,
        [data-theme="light"] .stat-card::after, [data-theme="light"] .url-card::after, [data-theme="light"] .shorten-card::after {
            display: none !important; animation: none !important; opacity: 0 !important;
        }

        [data-theme="light"] #particles-js, [data-theme="light"] #snow-particles {
            display: none !important; opacity: 0 !important; visibility: hidden !important; z-index: -10 !important;
        }

        .stat-card > div, .url-card > div, .shorten-card > * { position: relative; z-index: 1; }
        .stat-card:hover { transform: translateY(-2px); }
        .stat-label { font-size: .8rem; color: var(--muted); font-weight: 500; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .5rem; }
        .stat-value { font-size: 2rem; font-weight: 800; }
        .stat-sub { font-size: .8rem; color: var(--muted); margin-top: .3rem; }
        .gradient-text { background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

        /* Shorten Form */
        .shorten-card {
            background: var(--card); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;
            margin-bottom: 2rem; position: relative; overflow: hidden; transition: all .3s ease;
        }
        .shorten-card h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; }
        .form-row { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
        .form-group { display: block; }
        label { display: block; font-size: .8rem; font-weight: 600; margin-bottom: .5rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .04em; }
        input, select { width: 100%; background: var(--input-bg); border: 1px solid var(--border); border-radius: 10px; padding: .75rem 1rem; color: var(--text); font-size: .9rem; font-family: inherit; outline: none; transition: all .2s; }
        input:focus, select:focus { border-color: var(--primary); background: var(--input-focus-bg); }
        input::placeholder { color: var(--muted); }
        select option { background: var(--select-bg); color: var(--text); }
        .toggle-more { background: none; border: none; color: var(--muted); font-size: .8rem; cursor: pointer; font-family: inherit; padding: 0; margin-bottom: 1rem; }
        .toggle-more:hover { color: var(--primary-l); }
        .advanced-opts { display: none; }
        .advanced-opts.open { display: block; }

        /* URL Table */
        .filter-bar { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; }
        .search-box { flex: 1; min-width: 200px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: .65rem 1rem; color: var(--text); font-family: inherit; font-size: .9rem; outline: none; transition: all .2s; }
        .search-box:focus { border-color: var(--primary); }
        .category-filter { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: .65rem 1rem; color: var(--text); font-family: inherit; font-size: .85rem; outline: none; }
        .url-list { display: flex; flex-direction: column; gap: .75rem; }
        .url-card {
            background: var(--card); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1.5rem;
            display: flex; align-items: center; gap: 1rem; transition: all .3s ease; position: relative; overflow: hidden;
        }
        .url-card:hover { transform: translateY(-1px); }
        .url-main { flex: 1; min-width: 0; }
        .url-short { font-weight: 700; font-size: 1rem; color: var(--primary-l); text-decoration: none; }
        .url-short:hover { color: var(--accent); }
        .url-full { font-size: .8rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 400px; margin-top: .2rem; }
        .url-meta { display: flex; gap: .75rem; margin-top: .5rem; flex-wrap: wrap; }
        .tag {
            display: inline-flex; align-items: center; gap: .3rem;
            padding: .2rem .6rem; border-radius: 6px; font-size: .72rem; font-weight: 600;
        }
        .tag-cat { background: var(--tag-cat-bg); color: var(--primary-l); }
        .tag-pw { background: var(--tag-pw-bg); color: var(--tag-pw-color); }
        .tag-exp { background: var(--tag-exp-bg); color: var(--tag-exp-color); }
        .url-clicks { text-align: center; padding: 0 1rem; border-left: 1px solid var(--border); border-right: 1px solid var(--border); }
        .clicks-num { font-size: 1.5rem; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .clicks-label { font-size: .7rem; color: var(--muted); font-weight: 500; }
        .url-actions { display: flex; gap: .5rem; }

        /* Analytics Modal */
        .modal-overlay {
            position: fixed; inset: 0; z-index: 200;
            background: var(--modal-overlay); backdrop-filter: blur(8px);
            display: flex; align-items: center; justify-content: center; padding: 1rem;
            opacity: 0; pointer-events: none; transition: opacity .3s;
        }
        .modal-overlay.open { opacity: 1; pointer-events: all; }
        .modal {
            background: var(--modal-bg); border: 1px solid var(--border); border-radius: 20px;
            width: 100%; max-width: 860px; max-height: 90vh; overflow-y: auto;
            padding: 2rem; position: relative;
            transform: translateY(20px); transition: transform .3s;
        }
        .modal-overlay.open .modal { transform: translateY(0); }
        .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
        .modal-close { background: var(--card); border: 1px solid var(--border); border-radius: 8px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text); font-size: 1.2rem; transition: all .2s; }
        .modal-close:hover { background: rgba(239,68,68,.2); border-color: var(--danger); }
        .analytics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .chart-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
        .chart-card h4 { font-size: .85rem; font-weight: 600; margin-bottom: 1rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; }
        .chart-wrap { position: relative; height: 160px; }
        .bar-chart { display: flex; flex-direction: column; gap: .5rem; }
        .bar-row { display: flex; align-items: center; gap: .75rem; font-size: .8rem; }
        .bar-label { width: 80px; text-align: right; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .bar-track { flex: 1; background: rgba(255,255,255,.06); border-radius: 100px; height: 8px; overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 100px; background: var(--gradient); transition: width .6s ease; }
        .bar-count { width: 30px; color: var(--text); font-weight: 600; }

        /* QR Modal */
        .qr-modal-content { text-align: center; }
        .qr-img { border: 4px solid var(--border); border-radius: 12px; margin: 1rem auto; display: block; max-width: 260px; }
        .qr-link { font-size: .85rem; color: var(--muted); word-break: break-all; margin-top: .5rem; }

        /* API Key Panel */
        .api-key-box {
            background: var(--api-box-bg); border: 1px solid var(--border); border-radius: 10px;
            padding: 1rem 1.25rem; font-family: 'Courier New', monospace; font-size: .95rem;
            display: flex; align-items: center; gap: 1rem; word-break: break-all; margin: 1rem 0;
        }
        .api-key-text { flex: 1; color: var(--primary-l); }
        .copy-btn { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: .4rem .8rem; color: var(--text); cursor: pointer; font-size: .8rem; font-family: inherit; transition: all .2s; flex-shrink: 0; }
        .copy-btn:hover { border-color: var(--primary-l); color: var(--primary-l); }

        /* Toast */
        .toast {
            position: fixed; bottom: 2rem; right: 2rem; z-index: 999;
            background: var(--toast-bg); border: 1px solid var(--border); border-radius: 12px;
            padding: 1rem 1.5rem; display: flex; align-items: center; gap: .75rem;
            transform: translateY(100px); opacity: 0; transition: all .4s cubic-bezier(.34,1.56,.64,1);
            box-shadow: 0 20px 40px rgba(0,0,0,.5); max-width: 380px;
        }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast-icon { font-size: 1.3rem; }
        .toast-msg { font-size: .9rem; font-weight: 500; }

        /* Empty state */
        .empty { text-align: center; padding: 4rem 2rem; }
        .empty-icon { font-size: 4rem; margin-bottom: 1rem; opacity: .5; }
        .empty h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: .5rem; }
        .empty p { color: var(--muted); font-size: .9rem; }

        /* Loading spinner */
        .spinner { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,.2); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
        @keyframes spin { to{ transform: rotate(360deg) } }

        /* Theme toggle */
        .theme-toggle {
            display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; border-radius: 10px;
            color: var(--muted); cursor: pointer; transition: all .2s; border: none; background: none;
            width: 100%; text-align: left; font-size: .9rem; font-weight: 500; font-family: inherit;
        }
        .theme-toggle:hover { background: rgba(124,58,237,.15); color: var(--primary-l); }
        .theme-toggle .icon { font-size: 1.1rem; width: 20px; text-align: center; }

        @media (max-width: 768px) {
            .sidebar { display: none; }
            .form-row { grid-template-columns: 1fr; }
            .url-card { flex-direction: column; align-items: flex-start; }
            .url-clicks { border: none; padding: 0; }
        }

        /* Particle Holders */
        #particles-js { position: fixed; width: 100vw; height: 100vh; top: 0; left: 0; z-index: -2; opacity: 0.8; pointer-events: none; }
        #snow-particles { position: fixed; width: 100vw; height: 100vh; top: 0; left: 0; z-index: -1; opacity: 0.3; pointer-events: none; }
    </style>
</head>
<body>
    <div id="particles-js"></div>
    <div id="snow-particles"></div>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo"><div class="logo-text">⚡ LinkSnap</div></div>
        <nav class="sidebar-nav">
            <button class="nav-item active" onclick="showPanel('links')"><span class="icon">🔗</span> My Links</button>
            <button class="nav-item" onclick="showPanel('analytics')"><span class="icon">📊</span> Analytics</button>
            <button class="nav-item" onclick="showPanel('apikey')"><span class="icon">🔑</span> API Key</button>
            <a href="/admin" class="nav-item"><span class="icon">⚙️</span> Admin Panel</a>
            <% if (user.email === 'dhruv9671267714@gmail.com') { %>
            <a href="/superadmin/dashboard" class="nav-item" style="color:var(--success)"><span class="icon">👑</span> Super Admin</a>
            <% } %>
            <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()">
                <span class="icon" id="themeIcon">🌙</span> <span id="themeLabel">Dark Mode</span>
            </button>
            <a href="/auth/logout" class="nav-item" style="margin-top:auto;color:var(--danger)"><span class="icon">🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-pill">
                <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                <div class="user-info">
                    <div class="name"><%= user.username %></div>
                    <div class="email"><%= user.email.substring(0,22) %><%= user.email.length>22?'...':'' %></div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main">
        <div class="topbar">
            <h1 id="panel-title">My Links</h1>
            <div class="topbar-actions">
                <button class="btn btn-danger btn-sm" id="deleteAllBtn" onclick="deleteAll()">🗑 Delete All</button>
                <a href="/auth/logout" class="btn btn-ghost btn-sm">Logout</a>
            </div>
        </div>

        <div class="content">
            <!-- ── LINKS PANEL ── -->
            <div class="panel active" id="panel-links">
                <!-- Stats -->
                <div class="stats-grid" id="statsGrid">
                    <div class="stat-card">
                        <div class="stat-label">Total Links</div>
                        <div class="stat-value gradient-text" id="statLinks"><%=urls.length%></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Clicks</div>
                        <div class="stat-value gradient-text" id="statClicks"><%= urls.reduce((a,u)=>a+u.clicks,0) %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Categories</div>
                        <div class="stat-value gradient-text" id="statCats"><%=categories.length%></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Active Links</div>
                        <div class="stat-value gradient-text" id="statActive"><%= urls.filter(u=>new Date(u.expiresAt)>new Date()).length %></div>
                    </div>
                </div>

                <!-- Shorten Form -->
                <div class="shorten-card">
                    <h2>✨ Create New Short Link</h2>
                    <div class="form-group" style="margin-bottom:1rem">
                        <label>Long URL *</label>
                        <input type="url" id="fullUrl" placeholder="https://example.com/very/long/link...">
                    </div>
                    <button class="toggle-more" onclick="toggleAdvanced()">⚙️ Advanced options ▼</button>
                    <div class="advanced-opts" id="advancedOpts">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Custom Alias</label>
                                <input type="text" id="customCode" placeholder="my-link">
                            </div>
                            <div class="form-group">
                                <label>Category</label>
                                <input type="text" id="category" placeholder="Marketing" value="General">
                            </div>
                            <div class="form-group">
                                <label>Expires In</label>
                                <select id="expiry">
                                    <option value="1h">1 Hour</option>
                                    <option value="6h">6 Hours</option>
                                    <option value="1d" selected>1 Day</option>
                                    <option value="7d">7 Days</option>
                                    <option value="30d">30 Days</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Password (optional)</label>
                                <input type="password" id="password" placeholder="Leave blank for none">
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-primary" id="shortenBtn" onclick="shortenUrl()">
                        <span>⚡ Shorten URL</span>
                    </button>
                </div>

                <!-- Filter Bar -->
                <div class="filter-bar">
                    <input type="text" class="search-box" placeholder="🔍 Search links..." id="searchBox" oninput="filterUrls()">
                    <select class="category-filter" id="catFilter" onchange="filterUrls()">
                        <option value="">All Categories</option>
                        <% categories.forEach(c => { %><option value="<%=c%>"><%=c%></option><% }) %>
                    </select>
                </div>

                <!-- URL List -->
                <div class="url-list" id="urlList">
                    <% if(urls.length === 0) { %>
                    <div class="empty">
                        <div class="empty-icon">🔗</div>
                        <h3>No links yet</h3>
                        <p>Create your first short link above!</p>
                    </div>
                    <% } else { urls.forEach(url => { %>
                    <div class="url-card" data-id="<%=url._id%>" data-cat="<%=url.category||'General'%>" data-short="<%=url.shortUrl%>" data-full="<%=url.fullUrl%>">
                        <div class="url-main">
                            <a href="/<%= url.shortUrl %>" target="_blank" class="url-short">/<%= url.shortUrl %></a>
                            <div class="url-full" title="<%=url.fullUrl%>"><%= url.fullUrl %></div>
                            <div class="url-meta">
                                <span class="tag tag-cat">🏷 <%=url.category||'General'%></span>
                                <% if(url.password) { %><span class="tag tag-pw">🔒 Protected</span><% } %>
                                <span class="tag tag-exp">⏱ <%= new Date(url.expiresAt).toLocaleDateString() %></span>
                            </div>
                        </div>
                        <div class="url-clicks">
                            <div class="clicks-num"><%=url.clicks%></div>
                            <div class="clicks-label">clicks</div>
                        </div>
                        <div class="url-actions">
                            <button class="btn btn-ghost btn-sm" onclick="copyLink('<%=baseUrl%>/<%=url.shortUrl%>')" title="Copy">📋</button>
                            <button class="btn btn-ghost btn-sm" onclick="showQR('<%=url._id%>','<%=url.shortUrl%>')" title="QR Code">📱</button>
                            <button class="btn btn-ghost btn-sm" onclick="showAnalytics('<%=url._id%>','<%=url.shortUrl%>')" title="Analytics">📊</button>
                            <button class="btn btn-danger btn-sm" onclick="deleteUrl('<%=url._id%>')" title="Delete">🗑</button>
                        </div>
                    </div>
                    <% }) } %>
                </div>
            </div>

            <!-- ── ANALYTICS PANEL ── -->
            <div class="panel" id="panel-analytics">
                <h2 style="margin-bottom:1.5rem;font-size:1.4rem">📊 Overall Analytics</h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Total Links</div>
                        <div class="stat-value gradient-text"><%=urls.length%></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Clicks</div>
                        <div class="stat-value gradient-text"><%= urls.reduce((a,u)=>a+u.clicks,0) %></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Top Link</div>
                        <div class="stat-value gradient-text" style="font-size:1rem">
                            <% const top = urls.sort((a,b)=>b.clicks-a.clicks)[0]; %>
                            <%=top ? '/'+top.shortUrl : 'N/A'%>
                        </div>
                    </div>
                </div>
                <div class="shorten-card" style="margin-top:1.5rem">
                    <p style="color:var(--muted);font-size:.9rem">Click the 📊 button on any link to see detailed analytics including browsers, OS, devices, referrers, and daily trends.</p>
                </div>
            </div>

            <!-- ── API KEY PANEL ── -->
            <div class="panel" id="panel-apikey">
                <h2 style="margin-bottom:.5rem;font-size:1.4rem">🔑 API Access</h2>
                <p style="color:var(--muted);font-size:.9rem;margin-bottom:2rem">Use your API key to shorten URLs programmatically from your own applications.</p>
                <div class="shorten-card">
                    <h3 style="margin-bottom:1rem">Your API Key</h3>
                    <div class="api-key-box">
                        <div class="api-key-text" id="apiKeyDisplay">Loading...</div>
                        <button class="copy-btn" onclick="copyApiKey()">Copy</button>
                    </div>
                    <button class="btn btn-primary" onclick="generateApiKey()" style="margin-right:.75rem">🔄 Generate New Key</button>
                    <p style="color:var(--muted);font-size:.8rem;margin-top:1rem">⚠️ Regenerating a key will invalidate the old one immediately.</p>
                    <div class="shorten-card" style="margin-top:2rem;background:var(--api-box-bg)">
                        <h4 style="margin-bottom:1rem;font-size:.95rem">📖 API Usage</h4>
                        <pre style="color:#a78bfa;font-size:.8rem;overflow-x:auto;line-height:1.7">POST /urls/api/shorten
Headers: x-api-key: YOUR_KEY
         Content-Type: application/json
Body:    { "fullUrl": "https://example.com",
           "expiry": "7d",
           "category": "Marketing" }</pre>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Analytics Modal -->
    <div class="modal-overlay" id="analyticsModal">
        <div class="modal">
            <div class="modal-header">
                <h2 id="analyticsTitle">Analytics</h2>
                <button class="modal-close" onclick="closeModal('analyticsModal')">✕</button>
            </div>
            <div id="analyticsContent"></div>
        </div>
    </div>

    <!-- QR Modal -->
    <div class="modal-overlay" id="qrModal">
        <div class="modal" style="max-width:400px">
            <div class="modal-header">
                <h2>QR Code</h2>
                <button class="modal-close" onclick="closeModal('qrModal')">✕</button>
            </div>
            <div class="qr-modal-content" id="qrContent"></div>
        </div>
    </div>

    <!-- Premium Modal -->
    <div class="modal-overlay" id="premiumModal">
        <div class="modal">
            <button class="modal-close" onclick="closePremiumModal()">✕</button>
            <div style="text-align:center; margin-bottom:1.5rem">
                <span style="font-size:3rem">⭐</span>
                <h2 style="font-size:1.5rem;font-weight:700;color:var(--text);margin-top:.5rem">Get Premium</h2>
                <p style="color:var(--subtext);font-size:.9rem;margin-top:.5rem">Unlock unlimited links, custom 30-day expiries, and advanced analytics tracking.</p>
            </div>
            
            <div style="background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:1.5rem;text-align:center;margin-bottom:1.5rem;">
                <p style="font-weight:600;color:var(--text);margin-bottom:.5rem">Pay via UPI</p>
                <div style="background:rgba(125,42,232,0.1); border-radius:8px; padding:10px; font-size:1.3rem;font-weight:800;letter-spacing:1px;color:var(--primary);user-select:all;"><%= upiId %></div>
                <p style="color:var(--subtext);font-size:.8rem;margin-top:1rem;">Send exactly ₹99 to activate Premium forever.<br>Then <b>Msg Dhruv with Screenshot</b>.</p>
            </div>

            <button class="btn btn-primary" style="width:100%" onclick="closePremiumModal();toast('Thanks! Your upgrade will be processed as soon as possible.','⭐')">I Have Sent the Payment</button>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast" id="toast">
        <span class="toast-icon" id="toastIcon">✅</span>
        <span class="toast-msg" id="toastMsg"></span>
    </div>

    <script>
        const BASE_URL = '<%= baseUrl %>';

        // ── Theme Management ──────────────────────────────────────
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('dashboard-theme', theme);
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'light') {
                icon.textContent = '☀️';
                label.textContent = 'Light Mode';
            } else {
                icon.textContent = '🌙';
                label.textContent = 'Dark Mode';
            }
        }
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            setTheme(current === 'dark' ? 'light' : 'dark');
        }
        // Load saved theme
        (function() {
            const saved = localStorage.getItem('dashboard-theme') || 'dark';
            setTheme(saved);
        })();

        // ── Panel Navigation ──────────────────────────────────────
        function showPanel(name) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('panel-' + name).classList.add('active');
            document.querySelector(`[onclick="showPanel('${name}')"]`)?.classList.add('active');
            const titles = { links: 'My Links', analytics: 'Analytics', apikey: 'API Key' };
            document.getElementById('panel-title').textContent = titles[name] || name;
            if (name === 'apikey') loadApiKey();
        }

        // ── Advanced Options Toggle ───────────────────────────────
        function toggleAdvanced() {
            const el = document.getElementById('advancedOpts');
            el.classList.toggle('open');
        }

        // ── Shorten URL ───────────────────────────────────────────
        async function shortenUrl() {
            const btn = document.getElementById('shortenBtn');
            const url = document.getElementById('fullUrl').value.trim();
            if (!url) return toast('Please enter a URL', '⚠️');

            btn.innerHTML = '<div class="spinner"></div> Shortening...';
            btn.disabled = true;

            try {
                const res = await fetch('/urls/shorten', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fullUrl: url,
                        customShortCode: document.getElementById('customCode').value.trim() || undefined,
                        expiry: document.getElementById('expiry').value,
                        password: document.getElementById('password').value || undefined,
                        category: document.getElementById('category').value || 'General'
                    })
                });
                const data = await res.json();
                if (!res.ok) {
                    if (data.error === 'PREMIUM_REQUIRED') {
                        showPremiumModal();
                        return;
                    }
                    throw new Error(data.message || data.error);
                }

                copyLink(data.shortLink);
                toast('Link created & copied! ' + data.shortLink, '✅');
                document.getElementById('fullUrl').value = '';
                document.getElementById('customCode').value = '';
                document.getElementById('password').value = '';

                // Prepend new card to list
                const list = document.getElementById('urlList');
                const emptyEl = list.querySelector('.empty');
                if (emptyEl) emptyEl.remove();
                const card = buildUrlCard(data);
                list.prepend(card);
                updateStats();
            } catch(e) {
                toast(e.message || 'Failed to shorten URL', '⚠️');
            } finally {
                btn.innerHTML = '<span>⚡ Shorten URL</span>';
                btn.disabled = false;
            }
        }

        function buildUrlCard(data) {
            const card = document.createElement('div');
            card.className = 'url-card';
            card.dataset.id = data._id;
            card.dataset.cat = data.category || 'General';
            card.dataset.short = data.shortUrl;
            card.dataset.full = data.fullUrl;
            const exp = new Date(data.expiresAt).toLocaleDateString();
            card.innerHTML = `
                <div class="url-main">
                    <a href="/${data.shortUrl}" target="_blank" class="url-short">/${data.shortUrl}</a>
                    <div class="url-full" title="${data.fullUrl}">${data.fullUrl}</div>
                    <div class="url-meta">
                        <span class="tag tag-cat">🏷 ${data.category||'General'}</span>
                        ${data.hasPassword ? '<span class="tag tag-pw">🔒 Protected</span>' : ''}
                        <span class="tag tag-exp">⏱ ${exp}</span>
                    </div>
                </div>
                <div class="url-clicks"><div class="clicks-num">0</div><div class="clicks-label">clicks</div></div>
                <div class="url-actions">
                    <button class="btn btn-ghost btn-sm" onclick="copyLink('${data.shortLink}')" title="Copy">📋</button>
                    <button class="btn btn-ghost btn-sm" onclick="showQR('${data._id}','${data.shortUrl}')" title="QR Code">📱</button>
                    <button class="btn btn-ghost btn-sm" onclick="showAnalytics('${data._id}','${data.shortUrl}')" title="Analytics">📊</button>
                    <button class="btn btn-danger btn-sm" onclick="deleteUrl('${data._id}')" title="Delete">🗑</button>
                </div>`;
            return card;
        }

        // ── Filter / Search ───────────────────────────────────────
        function filterUrls() {
            const q = document.getElementById('searchBox').value.toLowerCase();
            const cat = document.getElementById('catFilter').value;
            document.querySelectorAll('.url-card').forEach(card => {
                const matchQ = !q || card.dataset.short.includes(q) || card.dataset.full.toLowerCase().includes(q);
                const matchC = !cat || card.dataset.cat === cat;
                card.style.display = matchQ && matchC ? '' : 'none';
            });
        }

        // ── Delete URL ────────────────────────────────────────────
        async function deleteUrl(id) {
            if (!confirm('Delete this link?')) return;
            const res = await fetch('/urls/' + id, { method: 'DELETE' });
            if (res.ok) {
                document.querySelector(`.url-card[data-id="${id}"]`)?.remove();
                updateStats();
                toast('Link deleted', '🗑');
            } else toast('Failed to delete', '❌');
        }

        async function deleteAll() {
            if (!confirm('Delete ALL your links? This cannot be undone!')) return;
            const res = await fetch('/urls/', { method: 'DELETE' });
            if (res.ok) {
                document.getElementById('urlList').innerHTML = `<div class="empty"><div class="empty-icon">🔗</div><h3>No links yet</h3><p>Create your first short link above!</p></div>`;
                updateStats();
                toast('All links deleted', '🗑');
            } else toast('Failed to delete all', '❌');
        }

        // ── QR Code ───────────────────────────────────────────────
        async function showQR(id, short) {
            const modal = document.getElementById('qrModal');
            document.getElementById('qrContent').innerHTML = '<div class="spinner" style="margin:2rem auto;width:40px;height:40px;border-width:4px"></div>';
            modal.classList.add('open');
            const res = await fetch('/urls/qr/' + id);
            const data = await res.json();
            if (res.ok) {
                document.getElementById('qrContent').innerHTML = `
                    <img src="${data.qr}" class="qr-img" alt="QR Code">
                    <div class="qr-link">${data.shortLink}</div>
                    <a href="${data.qr}" download="qr-${short}.png" class="btn btn-primary" style="margin:1.5rem auto 0;display:inline-flex">⬇ Download QR</a>`;
            } else document.getElementById('qrContent').innerHTML = '<p style="color:red">Failed to generate QR</p>';
        }

        // ── Analytics ─────────────────────────────────────────────
        async function showAnalytics(id, short) {
            const modal = document.getElementById('analyticsModal');
            document.getElementById('analyticsTitle').textContent = 'Analytics — /' + short;
            document.getElementById('analyticsContent').innerHTML = '<div class="spinner" style="margin:2rem auto;width:40px;height:40px;border-width:4px"></div>';
            modal.classList.add('open');
            const res = await fetch('/urls/analytics/' + id);
            const d = await res.json();
            if (!res.ok) { document.getElementById('analyticsContent').innerHTML = '<p style="color:red">Failed to load analytics</p>'; return; }

            const barHtml = (arr, max) => arr.slice(0,6).map(x => `
                <div class="bar-row">
                    <div class="bar-label" title="${x.name}">${x.name}</div>
                    <div class="bar-track"><div class="bar-fill" style="width:${max>0?Math.round(x.count/max*100):0}%"></div></div>
                    <div class="bar-count">${x.count}</div>
                </div>`).join('');

            const maxB = Math.max(...(d.browsers.map(x=>x.count)||[1]));
            const maxO = Math.max(...(d.os.map(x=>x.count)||[1]));
            const maxD = Math.max(...(d.devices.map(x=>x.count)||[1]));
            const maxR = Math.max(...(d.referrers.map(x=>x.count)||[1]));

            document.getElementById('analyticsContent').innerHTML = `
                <div style="margin-bottom:1.5rem">
                    <span style="font-size:2.5rem;font-weight:900;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent">${d.total}</span>
                    <span style="color:var(--muted);margin-left:.5rem">total clicks</span>
                </div>
                <div class="analytics-grid">
                    <div class="chart-card"><h4>🌐 Browsers</h4><div class="bar-chart">${barHtml(d.browsers, maxB)}</div></div>
                    <div class="chart-card"><h4>💻 Operating Systems</h4><div class="bar-chart">${barHtml(d.os, maxO)}</div></div>
                    <div class="chart-card"><h4>📱 Devices</h4><div class="bar-chart">${barHtml(d.devices, maxD)}</div></div>
                    <div class="chart-card"><h4>🔗 Referrers</h4><div class="bar-chart">${barHtml(d.referrers, maxR)}</div></div>
                </div>
                ${d.daily.length > 0 ? `
                <div class="chart-card" style="margin-top:1rem">
                    <h4>📈 Clicks Over Time</h4>
                    <div class="chart-wrap"><canvas id="dailyChart"></canvas></div>
                </div>` : ''}`;

            if (d.daily.length > 0) {
                setTimeout(() => {
                    const ctx = document.getElementById('dailyChart');
                    if (ctx) new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: d.daily.map(x=>x.date),
                            datasets: [{ label:'Clicks', data: d.daily.map(x=>x.count),
                                borderColor:'#7c3aed', backgroundColor:'rgba(124,58,237,.15)',
                                fill:true, tension:.4, pointRadius:4, pointBackgroundColor:'#a78bfa' }]
                        },
                        options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}},
                            scales:{ x:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#64748b'}},
                                y:{grid:{color:'rgba(255,255,255,.05)'},ticks:{color:'#64748b'}} } }
                    });
                }, 50);
            }
        }

        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        // ── API Key ───────────────────────────────────────────────
        async function loadApiKey() {
            const res = await fetch('/auth/api-key');
            const d = await res.json();
            document.getElementById('apiKeyDisplay').textContent = d.apiKey || 'No key generated yet';
        }
        async function generateApiKey() {
            if (!confirm('Generate a new API key? Old one will be invalidated.')) return;
            const res = await fetch('/auth/generate-api-key', { method:'POST' });
            const d = await res.json();
            document.getElementById('apiKeyDisplay').textContent = d.apiKey;
            toast('New API key generated!', '🔑');
        }
        function copyApiKey() {
            const key = document.getElementById('apiKeyDisplay').textContent;
            navigator.clipboard.writeText(key);
            toast('API key copied!', '📋');
        }

        // ── Helpers ───────────────────────────────────────────────
        function copyLink(link) {
            navigator.clipboard.writeText(link).catch(()=>{});
        }

        function updateStats() {
            const cards = document.querySelectorAll('.url-card');
            let totalClicks = 0;
            const cats = new Set();
            let active = 0;
            cards.forEach(c => {
                const clicks = parseInt(c.querySelector('.clicks-num')?.textContent || 0);
                totalClicks += clicks;
                if (c.dataset.cat) cats.add(c.dataset.cat);
            });
            document.getElementById('statLinks').textContent = cards.length;
            document.getElementById('statClicks').textContent = totalClicks;
            document.getElementById('statCats').textContent = cats.size;
        }

        function toast(msg, icon='✅') {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            document.getElementById('toastIcon').textContent = icon;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3500);
        }

        // Close modals on overlay click
        document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', e => { if(e.target===o) o.classList.remove('open'); }));
        function closePremiumModal() {
            document.getElementById('premiumModal').classList.remove('open');
        }
        function showPremiumModal() {
            document.getElementById('premiumModal').classList.add('open');
        }

    </script>
    
    <% if (needsPassword) { %>
    <!-- Set Password Modal for Google Auth Users -->
    <div class="modal-overlay open" id="setPasswordModal">
        <div class="modal shadow-2xl">
            <div style="text-align:center; margin-bottom:1.5rem">
                <span style="font-size:3rem">🔐</span>
                <h2 style="font-size:1.5rem;font-weight:700;color:var(--text);margin-top:.5rem">Secure Your Account</h2>
                <p style="color:var(--subtext);font-size:.9rem;margin-top:.5rem">You signed up with Google. Please set a backup password so you can optionally log in via email in the future.</p>
            </div>
            
            <div style="margin-bottom:1.5rem;">
                <label style="display:block;margin-bottom:.5rem;color:var(--text);font-size:.9rem;font-weight:600">New Password</label>
                <input type="password" id="newBackupPassword" style="width:100%;padding:12px;border-radius:12px;background:var(--bg);border:1px solid var(--border);color:var(--text);outline:none;font-size:1rem" placeholder="At least 6 characters">
            </div>

            <div style="display:flex;gap:1rem">
                <button class="btn btn-ghost" style="flex:1" onclick="closePasswordModal()">Skip for now</button>
                <button class="btn btn-primary" style="flex:1" id="savePasswordBtn" onclick="saveNewPassword()">Save Password</button>
            </div>
        </div>
    </div>
    
    <script>
        function closePasswordModal() {
            document.getElementById('setPasswordModal').classList.remove('open');
        }
        
        async function saveNewPassword() {
            const pwd = document.getElementById('newBackupPassword').value;
            if(!pwd || pwd.length < 6) return toast('Password must be at least 6 characters', '⚠️');
            
            const btn = document.getElementById('savePasswordBtn');
            btn.innerHTML = '<div class="spinner"></div>';
            btn.disabled = true;
            
            try {
                const res = await fetch('/auth/set-password', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ password: pwd })
                });
                const data = await res.json();
                if(res.ok) {
                    toast(data.message || 'Password set successfully!', '✅');
                    closePasswordModal();
                } else {
                    toast(data.error || 'Failed to set password', '❌');
                }
            } catch(e) {
                toast('Network error', '❌');
            } finally {
                btn.innerHTML = 'Save Password';
                btn.disabled = false;
            }
        }
    </script>
    <% } %>

</body>
</html>
