    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #fafbfc;
            color: #1a1a2e;
            overflow-x: hidden;
        }

        /* ✦ floating particles (light version) */
        .snow {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }

        .snowflake {
            position: absolute;
            border-radius: 50%;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% {
                transform: translateY(-10px);
                opacity: 1;
            }

            100% {
                transform: translateY(100vh);
                opacity: 0;
            }
        }

        /* 🧊 glass — light mode */
        .glass {
            background: rgba(255, 255, 255, .7);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 0, 0, .06);
            box-shadow: 0 4px 24px rgba(0, 0, 0, .04);
            transition: all .35s cubic-bezier(.4, 0, .2, 1);
        }

        .glass:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(125, 42, 232, .1);
            border-color: rgba(125, 42, 232, .2);
        }

        /* 💎 button */
        .btn {
            background: linear-gradient(135deg, #7d2ae8, #6025c0);
            color: #fff;
            position: relative;
            overflow: hidden;
            transition: all .3s cubic-bezier(.4, 0, .2, 1);
            box-shadow: 0 4px 16px rgba(125, 42, 232, .3);
        }

        .btn:hover {
            box-shadow: 0 8px 32px rgba(125, 42, 232, .45);
            transform: translateY(-2px);
        }

        .btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, .5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1) translate(-50%);
        }

        .btn:focus:not(:active)::after {
            animation: ripple 1s ease-out;
        }

        @keyframes ripple {
            0% {
                transform: scale(0);
                opacity: .5;
            }

            100% {
                transform: scale(20);
                opacity: 0;
            }
        }

        /* secondary button */
        .btn-secondary {
            background: rgba(125, 42, 232, .06);
            color: #7d2ae8;
            transition: all .3s;
            border: 1px solid rgba(125, 42, 232, .1);
        }

        .btn-secondary:hover {
            background: rgba(125, 42, 232, .12);
            transform: translateY(-2px);
        }

        /* ✨ gradient text */
        .gradient {
            background: linear-gradient(135deg, #7d2ae8, #06b6d4);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* hero bg blobs */
        .hero-bg {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }

        .hero-bg .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            animation: float 12s ease-in-out infinite alternate;
        }

        .hero-bg .blob-1 {
            width: 500px;
            height: 500px;
            background: rgba(125, 42, 232, .12);
            top: -100px;
            left: -100px;
        }

        .hero-bg .blob-2 {
            width: 400px;
            height: 400px;
            background: rgba(6, 182, 212, .1);
            bottom: -80px;
            right: -80px;
            animation-delay: 4s;
        }

        .hero-bg .blob-3 {
            width: 300px;
            height: 300px;
            background: rgba(236, 72, 153, .08);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: 2s;
        }

        @keyframes float {
            from {
                transform: translateY(0px) scale(1);
            }

            to {
                transform: translateY(-40px) scale(1.05);
            }
        }

        /* 🎬 scroll reveal */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all .8s cubic-bezier(.16, 1, .3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* 🔢 counter */
        .counter {
            font-variant-numeric: tabular-nums;
        }

        /* 📐 stepper */
        .step-line {
            position: absolute;
            left: 23px;
            top: 48px;
            bottom: -48px;
            width: 2px;
            background: linear-gradient(180deg, rgba(125, 42, 232, .4), transparent);
        }

        /* ❓ FAQ */
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height .4s ease, padding .4s ease;
        }

        .faq-answer.open {
            max-height: 200px;
            padding-top: 12px;
        }

        .faq-chevron {
            transition: transform .3s;
        }

        .faq-chevron.open {
            transform: rotate(180deg);
        }

        /* 🌊 marquee */
        @keyframes scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .marquee-track {
            animation: scroll 30s linear infinite;
        }

        /* subtle grid bg */
        .grid-bg {
            background-image:
                linear-gradient(rgba(125, 42, 232, .03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(125, 42, 232, .03) 1px, transparent 1px);
            background-size: 60px 60px;
        }
    </style>
