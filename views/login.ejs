<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - LinkSnap</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background: #fafbfc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* bg blobs */
        .bg-blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
            animation: float 12s ease-in-out infinite alternate;
        }

        .blob-1 {
            width: 400px; height: 400px;
            background: rgba(125, 42, 232, .1);
            top: -80px; left: -80px;
        }

        .blob-2 {
            width: 350px; height: 350px;
            background: rgba(6, 182, 212, .08);
            bottom: -60px; right: -60px;
            animation-delay: 4s;
        }

        @keyframes float {
            from { transform: translateY(0) scale(1); }
            to { transform: translateY(-30px) scale(1.05); }
        }

        /* grid bg */
        .grid-bg {
            background-image:
                linear-gradient(rgba(125, 42, 232, .03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(125, 42, 232, .03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* glass card */
        .glass-card {
            background: rgba(255, 255, 255, .75);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 0, 0, .06);
            box-shadow: 0 8px 40px rgba(0, 0, 0, .06);
        }

        /* input */
        .glass-input {
            background: rgba(0, 0, 0, .02);
            border: 1px solid rgba(0, 0, 0, .08);
            transition: 0.3s;
            color: #1a1a2e;
        }

        .glass-input:focus {
            border-color: rgba(125, 42, 232, .4);
            box-shadow: 0 0 0 3px rgba(125, 42, 232, .1);
            background: #fff;
        }

        .glass-input::placeholder {
            color: #a0a0b0;
        }

        /* button */
        .btn-primary {
            background: linear-gradient(135deg, #7d2ae8, #6025c0);
            color: #fff;
            transition: all 0.3s cubic-bezier(.4, 0, .2, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(125, 42, 232, .25);
        }

        .btn-primary:hover {
            box-shadow: 0 8px 28px rgba(125, 42, 232, .4);
            transform: translateY(-1px);
        }

        /* ripple */
        .btn-primary::after {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            width: 5px; height: 5px;
            background: rgba(255, 255, 255, .5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1) translate(-50%);
        }

        .btn-primary:focus:not(:active)::after {
            animation: ripple 1s ease-out;
        }

        @keyframes ripple {
            0% { transform: scale(0); opacity: .5; }
            100% { transform: scale(20); opacity: 0; }
        }

        /* loading */
        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        /* fade */
        .fade-in {
            animation: fadeIn 0.6s cubic-bezier(.16, 1, .3, 1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* particles */
        .snow { position: fixed; inset: 0; pointer-events: none; z-index: 1; }
        .snowflake {
            position: absolute;
            border-radius: 50%;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(-10px); opacity: 1; }
            100% { transform: translateY(100vh); opacity: 0; }
        }

        /* gradient text */
        .gradient {
            background: linear-gradient(135deg, #7d2ae8, #06b6d4);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4 grid-bg relative">

    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>
    <div class="snow" id="snow"></div>

    <div class="relative z-10 w-full max-w-sm">
        <!-- Back to home -->
        <a href="/" class="inline-flex items-center gap-2 text-gray-400 hover:text-gray-700 text-sm font-medium mb-6 transition">
            <i class="fas fa-arrow-left text-xs"></i> Back to home
        </a>

        <div class="glass-card p-8 rounded-2xl fade-in">

            <div class="text-center mb-8">
                <a href="/" class="text-2xl font-bold text-gray-900 inline-flex items-center gap-2">
                    ⚡ LinkSnap
                </a>
                <h1 class="text-xl font-bold text-gray-900 mt-4">Welcome back</h1>
                <p class="text-gray-400 text-sm mt-1">Sign in to your account</p>
            </div>

            <% if (typeof error !=='undefined' ) { %>
                <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-4 text-sm">
                    <i class="fas fa-exclamation-circle mr-1"></i> <%= error %>
                </div>
            <% } %>

            <form id="loginForm" method="POST" action="/auth/login" class="space-y-5">

                <div>
                    <label class="text-gray-600 text-sm font-medium mb-2 block">Email</label>
                    <input class="glass-input w-full py-3 px-4 rounded-xl focus:outline-none"
                        type="email" name="email" required placeholder="you@gmail.com">
                </div>

                <div>
                    <label class="text-gray-600 text-sm font-medium mb-2 block">Password</label>
                    <input class="glass-input w-full py-3 px-4 rounded-xl focus:outline-none"
                        type="password" name="password" required placeholder="••••••••">
                </div>

                <button id="loginBtn" class="btn-primary font-semibold py-3 px-4 rounded-xl w-full text-white">
                    <i class="fas fa-sign-in-alt mr-2"></i>Sign In
                </button>

            </form>

            <div class="mt-6 flex flex-col items-center">
                <div class="flex items-center w-full mb-4">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="mx-4 text-xs text-gray-400 font-medium uppercase tracking-wider">Or continue with</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>
                
                <div id="g_id_onload"
                    data-client_id="<%= googleClientId %>"
                    data-context="signin"
                    data-ux_mode="popup"
                    data-callback="handleGoogleCallback"
                    data-auto_prompt="false">
                </div>

                <div class="g_id_signin"
                    data-type="standard"
                    data-shape="rectangular"
                    data-theme="outline"
                    data-text="signin_with"
                    data-size="large"
                    data-logo_alignment="left"
                    style="width: 100%; display: flex; justify-content: center;">
                </div>
            </div>

            <div class="flex justify-between mt-6 text-sm">
                <a href="/auth/forgot" class="text-gray-400 hover:text-purple-600 transition">Forgot password?</a>
                <a href="/register" class="text-purple-600 hover:text-purple-800 font-medium transition">Create account</a>
            </div>

        </div>
    </div>

    <script>
        async function handleGoogleCallback(response) {
            try {
                const btn = document.getElementById('loginBtn');
                btn.classList.add('loading');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Verifying Google login...';
                
                const res = await fetch('/auth/google', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ credential: response.credential })
                });
                
                const data = await res.json();
                
                if (res.ok && data.success) {
                    window.location.href = data.redirectUrl || '/main';
                } else {
                    alert(data.error || 'Google login failed');
                    btn.classList.remove('loading');
                    btn.innerHTML = '<i class="fas fa-sign-in-alt mr-2"></i>Sign In';
                }
            } catch (error) {
                console.error('Error logging in with Google', error);
                alert('Connection error');
            }
        }

        // loading state
        document.getElementById('loginForm').addEventListener('submit', function () {
            const btn = document.getElementById('loginBtn');
            btn.classList.add('loading');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Signing in...';
        });

        // particles
        const colors = ['rgba(125,42,232,.25)', 'rgba(6,182,212,.2)', 'rgba(236,72,153,.15)', 'rgba(99,102,241,.15)'];
        function snow() {
            const s = document.getElementById('snow');
            const el = document.createElement('div');
            el.className = 'snowflake';
            const size = Math.random() * 4 + 2;
            el.style.width = size + 'px';
            el.style.height = size + 'px';
            el.style.left = Math.random() * 100 + '%';
            el.style.background = colors[Math.floor(Math.random() * colors.length)];
            el.style.animationDuration = (Math.random() * 6 + 6) + 's';
            s.appendChild(el);
            setTimeout(() => el.remove(), 12000);
        }
        setInterval(snow, 200);
    </script>

</body>

</html>