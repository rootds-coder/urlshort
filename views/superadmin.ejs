<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin — LinkSnap</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #0a0a0f; --bg2: #12121a; --card: rgba(255,255,255,.04); --border: rgba(255,255,255,.08);
            --primary: #7c3aed; --primary-l: #a78bfa; --accent: #06b6d4;
            --text: #e2e8f0; --muted: #64748b; --danger: #ef4444;
            --gradient: linear-gradient(135deg, #7c3aed, #06b6d4);
            --success: #10b981; --warn: #f59e0b;
            --topbar-bg: rgba(10,10,15,.85);
            --modal-bg: #12121a; --modal-overlay: rgba(0,0,0,.7);
            --toast-bg: #1e293b;
            --danger-btn-bg: rgba(239,68,68,.1); --danger-btn-color: #fca5a5; --danger-btn-border: rgba(239,68,68,.2);
            --th-bg: rgba(255,255,255,.02);
        }

        [data-theme="light"] {
            --bg: #fafbfc; --bg2: #ffffff; --card: rgba(255,255,255,.7); --border: rgba(0,0,0,.08);
            --primary: #7c3aed; --primary-l: #7c3aed; --accent: #06b6d4;
            --text: #1a1a2e; --muted: #6b7280; --danger: #ef4444;
            --gradient: linear-gradient(135deg, #7c3aed, #06b6d4);
            --success: #10b981; --warn: #f59e0b;
            --topbar-bg: rgba(255,255,255,.85);
            --modal-bg: #ffffff; --modal-overlay: rgba(0,0,0,.3);
            --toast-bg: #ffffff;
            --danger-btn-bg: rgba(239,68,68,.06); --danger-btn-color: #dc2626; --danger-btn-border: rgba(239,68,68,.15);
            --th-bg: rgba(0,0,0,.02);
        }

        [data-theme="light"] .sidebar { box-shadow: 2px 0 20px rgba(0,0,0,.04); }
        [data-theme="light"] .stat-card { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        [data-theme="light"] .chart-card { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        [data-theme="light"] table { box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        [data-theme="light"] .toast { box-shadow: 0 8px 30px rgba(0,0,0,.1); border-color: var(--border); }
        [data-theme="light"] .spinner { border-color: rgba(0,0,0,.1); border-top-color: var(--primary); }

        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

        /* Sidebar */
        .sidebar {
            width: 240px; flex-shrink: 0; background: var(--bg2); border-right: 1px solid var(--border);
            display: flex; flex-direction: column; min-height: 100vh; position: sticky; top: 0; height: 100vh;
        }
        .sidebar-logo { padding: 1.5rem; border-bottom: 1px solid var(--border); }
        .logo-text { font-size: 1.3rem; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .sidebar-nav { padding: 1rem .75rem; flex: 1; }
        .nav-item {
            display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; border-radius: 10px;
            color: var(--muted); cursor: pointer; transition: all .2s; text-decoration: none; margin-bottom: .25rem;
            font-size: .9rem; font-weight: 500; border: none; background: none; width: 100%; text-align: left;
        }
        .nav-item:hover, .nav-item.active { background: rgba(124,58,237,.15); color: var(--primary-l); }
        .nav-item .icon { font-size: 1.1rem; width: 20px; text-align: center; }
        .sidebar-footer { padding: 1rem .75rem; border-top: 1px solid var(--border); }
        
        /* Main Config */
        .main { flex: 1; min-width: 0; overflow-y: auto; }
        .topbar {
            position: sticky; top: 0; z-index: 50;
            padding: 1rem 2rem; background: var(--topbar-bg); backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;
        }
        .topbar h1 { font-size: 1.25rem; font-weight: 700; }
        
        .btn { display: inline-flex; align-items: center; gap: .5rem; padding: .6rem 1.3rem; border-radius: 10px; font-weight: 600; font-size: .875rem; cursor: pointer; text-decoration: none; transition: all .2s; border: none; font-family: inherit; }
        .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
        .btn-ghost:hover { background: var(--btn-ghost-hover-bg); border-color: var(--primary-l); }
        .btn-danger { background: var(--danger-btn-bg); color: var(--danger-btn-color); border: 1px solid var(--danger-btn-border); }
        .btn-danger:hover { opacity: .85; }
        .btn-sm { padding: .4rem .9rem; font-size: .8rem; }

        .content { padding: 2rem; }
        .panel { display: none; }
        .panel.active { display: block; }

        /* Stats row */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem; transition: all .2s; }
        .stat-card:hover { border-color: rgba(124,58,237,.3); transform: translateY(-2px); }
        .stat-label { font-size: .8rem; color: var(--muted); font-weight: 500; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .5rem; }
        .stat-value { font-size: 2rem; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

        /* Graph Card */
        .chart-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem; margin-bottom: 2rem; }
        .chart-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; }
        .chart-wrap { position: relative; height: 300px; width: 100%; }

        /* User Table */
        .table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--border); border-radius: 14px; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 1.25rem 1.5rem; background: var(--th-bg); font-size: .8rem; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); }
        td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); color: var(--text); font-size: .95rem; }
        tr:last-child td { border-bottom: none; }
        .badge { background: rgba(124,58,237,.15); color: var(--primary-l); padding: .2rem .6rem; border-radius: 6px; font-size: .72rem; font-weight: 600; display: inline-block; margin-left: .5rem; }
        .spinner-center { width: 40px; height: 40px; border: 4px solid rgba(124,58,237,.2); border-top-color: var(--primary-l); border-radius: 50%; animation: spin 1s linear infinite; margin: 2rem auto; }
        
        /* Toast */
        .toast {
            position: fixed; bottom: 2rem; right: 2rem; z-index: 999;
            background: var(--toast-bg); border: 1px solid var(--border); border-radius: 12px;
            padding: 1rem 1.5rem; display: flex; align-items: center; gap: .75rem;
            transform: translateY(100px); opacity: 0; transition: all .4s cubic-bezier(.34,1.56,.64,1);
            box-shadow: 0 20px 40px rgba(0,0,0,.5); max-width: 380px;
        }
        .toast.show { transform: translateY(0); opacity: 1; }

        @keyframes spin { to { transform: rotate(360deg); } }
        
        /* Theme toggle */
        .theme-toggle {
            display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; border-radius: 10px;
            color: var(--muted); cursor: pointer; transition: all .2s; border: none; background: none;
            width: 100%; text-align: left; font-size: .9rem; font-weight: 500; font-family: inherit;
        }
        .theme-toggle:hover { background: rgba(124,58,237,.15); color: var(--primary-l); }
        .theme-toggle .icon { font-size: 1.1rem; width: 20px; text-align: center; }

        .mobile-menu-btn { display: none; background: none; border: none; color: var(--text); font-size: 1.5rem; cursor: pointer; margin-right: 0.75rem; transition: color 0.2s; }
        .mobile-menu-btn:hover { color: var(--primary-l); }
        .sidebar-overlay { 
            position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 150; 
            backdrop-filter: blur(4px); opacity: 0; pointer-events: none; transition: opacity 0.3s ease; 
        }
        .sidebar-overlay.active { opacity: 1; pointer-events: all; }

        @media (max-width: 768px) {
            .sidebar { 
                position: fixed; top: 0; left: 0; height: 100vh; z-index: 200; 
                transform: translateX(-100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            }
            .sidebar.mobile-open { transform: translateX(0); box-shadow: 2px 0 20px rgba(0,0,0,0.5); }
            .mobile-menu-btn { display: block; }
            .content { padding: 1.25rem; }
            .topbar { padding: 1rem; }
            .chart-wrap { height: 200px; }
        }
    </style>
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div class="logo-text">⚡ LinkSnap</div>
                <button class="mobile-menu-btn" onclick="toggleSidebar()" style="margin:0; font-size:1.2rem">&times;</button>
            </div>
        </div>
        <nav class="sidebar-nav">
            <button class="nav-item active" onclick="showPanel('overview')"><span class="icon">🌍</span> System Overview</button>
            <button class="nav-item" onclick="showPanel('users')"><span class="icon">👥</span> User Management</button>
            <button class="nav-item" onclick="showPanel('payments')"><span class="icon">💳</span> Payment Requests</button>
            <a href="/dashboard" class="nav-item" style="margin-top:2rem"><span class="icon">←</span> Back to App</a>
            <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" style="margin-top:auto">
                <span class="icon" id="themeIcon">🌙</span> <span id="themeLabel">Dark Mode</span>
            </button>
            <a href="/auth/logout" class="nav-item" style="color:var(--danger)"><span class="icon">🚪</span> Logout</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main">
        <div class="topbar">
            <div style="display: flex; align-items: center;">
                <button class="mobile-menu-btn" onclick="toggleSidebar()">☰</button>
                <h1 id="panel-title">System Overview</h1>
            </div>
            <div style="display:flex; gap: 10px;">
                <span style="background:linear-gradient(135deg,#7c3aed,#06b6d4);color:#fff;padding:.3rem .8rem;border-radius:20px;font-size:.8rem;font-weight:700;">ADMIN</span>
            </div>
        </div>

        <div class="content">
            <!-- ── OVERVIEW PANEL ── -->
            <div class="panel active" id="panel-overview">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Total Users</div>
                        <div class="stat-value" id="statUsers">...</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Links</div>
                        <div class="stat-value" id="statLinks">...</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">All-time Clicks</div>
                        <div class="stat-value" id="statClicks">...</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Links Today</div>
                        <div class="stat-value" id="statToday">...</div>
                    </div>
                </div>

                <div class="chart-card">
                    <h3>📈 Global Traffic (Last 30 Days)</h3>
                    <div class="chart-wrap">
                        <canvas id="trafficChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- ── USERS PANEL ── -->
            <div class="panel" id="panel-users">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Account</th>
                                <th>Email</th>
                                <th>Joined</th>
                                <th>Total Links</th>
                                <th>Total Clicks</th>
                                <th style="text-align:right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody">
                            <tr><td colspan="6"><div class="spinner-center"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── PAYMENTS PANEL ── -->
            <div class="panel" id="panel-payments">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>User</th>
                                <th>Plan & Amount</th>
                                <th>UTR Number</th>
                                <th>Status</th>
                                <th style="text-align:right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="paymentTableBody">
                            <tr><td colspan="5"><div class="spinner-center"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast -->
    <div class="toast" id="toast">
        <span class="toast-icon">✅</span>
        <span class="toast-msg" id="toastMsg"></span>
    </div>

    <script>
        // ── Theme Management ──────────────────────────────────────
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('dashboard-theme', theme);
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'light') {
                icon.textContent = '☀️';
                label.textContent = 'Light Mode';
            } else {
                icon.textContent = '🌙';
                label.textContent = 'Dark Mode';
            }
            if(window.myChartInstance && window.myChartInstance.options) {
                // Adjust chart grid color on theme change
                const isLight = theme === 'light';
                window.myChartInstance.options.scales.x.grid.color = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)';
                window.myChartInstance.options.scales.y.grid.color = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)';
                window.myChartInstance.update();
            }
        }
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            setTheme(current === 'dark' ? 'light' : 'dark');
        }
        (function() {
            const saved = localStorage.getItem('dashboard-theme') || 'dark';
            setTheme(saved);
        })();

        // ── Panel Navigation ──────────────────────────────────────
        function showPanel(name) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('panel-' + name).classList.add('active');
            document.querySelector(`[onclick="showPanel('${name}')"]`)?.classList.add('active');
            const titles = { overview: 'System Overview', users: 'User Management', payments: 'Payment Requests' };
            document.getElementById('panel-title').textContent = titles[name] || name;
            
            if(name === 'users' && !window.usersLoaded) {
                fetchUsers();
            }
            if(name === 'payments' && !window.paymentsLoaded) {
                fetchPayments();
            }
        }

        // ── Toast ─────────────────────────────────────────────────
        function toast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3500);
        }

        // ── Check Current User Initial Payload ─────────────────────
        const currentUserId = '<%= user._id.toString() %>';

        // ── Load Global Stats ─────────────────────────────────────
        async function loadStats() {
            try {
                const res = await fetch('/superadmin/api/stats');
                const data = await res.json();
                
                document.getElementById('statUsers').textContent = data.totals.users;
                document.getElementById('statLinks').textContent = data.totals.links;
                document.getElementById('statClicks').textContent = data.totals.clicks;
                document.getElementById('statToday').textContent = data.totals.linksToday;

                // Render Chart
                const ctx = document.getElementById('trafficChart');
                const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                const gridColor = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)';
                
                window.myChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.dailyClicks.map(x => x.date),
                        datasets: [{
                            label: 'System-wide Clicks', 
                            data: data.dailyClicks.map(x => x.count),
                            borderColor: '#7c3aed', 
                            backgroundColor: 'rgba(124,58,237,.15)',
                            fill: true, tension: .4, pointRadius: 4, pointBackgroundColor: '#a78bfa'
                        }]
                    },
                    options: { 
                        responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                        scales: { 
                            x: { grid: { color: gridColor }, ticks: { color: '#64748b' } },
                            y: { grid: { color: gridColor }, ticks: { color: '#64748b' } } 
                        } 
                    }
                });
            } catch(e) { console.error('Error loading stats:', e); }
        }

        // ── Load User List ────────────────────────────────────────
        async function fetchUsers() {
            try {
                const res = await fetch('/superadmin/api/users');
                const data = await res.json();
                const tbody = document.getElementById('userTableBody');
                
                if (data.users.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:#64748b">No users found.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.users.map(u => {
                    const isSelf = u._id === currentUserId;
                    const date = new Date(u.createdAt).toLocaleDateString();
                    return `
                        <tr id="userrow-${u._id}">
                            <td>
                                <strong>${u.username}</strong>
                                ${u.isAdmin ? '<span class="badge" style="background:var(--danger)">Admin</span>' : ''}
                                ${u.isPremium ? '<span class="badge" style="background:#f59e0b">Premium</span>' : ''}
                            </td>
                            <td>${u.email}</td>
                            <td>${date}</td>
                            <td>${u.linkCount}</td>
                            <td>${u.clickCount}</td>
                            <td style="text-align:right; display:flex; justify-content:flex-end; gap:0.5rem">
                                ${isSelf ? '<span style="color:#64748b;font-size:.8rem">It&apos;s you</span>' : 
                                `
                                <button class="btn btn-sm" style="background:${u.isPremium ? '#f59e0b' : '#3b82f6'};color:#fff;border:none;border-radius:6px;padding:4px 8px;cursor:pointer;font-weight:600" onclick="togglePremium('${u._id}', '${u.username}')">${u.isPremium ? 'Revoke Premium' : 'Grant Premium'}</button>
                                <button class="btn btn-danger btn-sm" onclick="deleteUser('${u._id}', '${u.username}')">Delete User</button>
                                `}
                            </td>
                        </tr>
                    `;
                }).join('');
                
                window.usersLoaded = true;
            } catch(e) {
                console.error("fetchUsers error:", e);
                document.getElementById('userTableBody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:red">Failed to load users. See browser console.</td></tr>';
            }
        }

        // ── Delete User ───────────────────────────────────────────
        async function deleteUser(id, username) {
            if (!confirm(`WARNING: Are you sure you want to permanently delete user "${username}"? This destroys all their links and analytics instantly!`)) return;
            
            try {
                const res = await fetch('/superadmin/api/users/' + id, { method: 'DELETE' });
                if (res.ok) {
                    document.getElementById('userrow-' + id).remove();
                    toast(`User ${username} deleted.`);
                    // reload overview stats
                    const userCount = parseInt(document.getElementById('statUsers').textContent);
                    document.getElementById('statUsers').textContent = Math.max(0, userCount - 1);
                } else {
                    const data = await res.json();
                    toast(data.error || 'Failed to delete user', '❌');
                }
            } catch(e) {
                toast('Network error while deleting', '❌');
            }
        }

        // ── Toggle Premium ────────────────────────────────────────
        async function togglePremium(id, username) {
            try {
                const res = await fetch('/superadmin/api/users/' + id + '/premium', { method: 'PATCH' });
                const data = await res.json();
                if (res.ok) {
                    toast(data.message, '⭐');
                    fetchUsers(); // refresh the table
                } else {
                    toast(data.error || 'Failed to update user', '❌');
                }
            } catch(e) {
                toast('Network error updating premium', '❌');
            }
        }

        // ── Fetch Payments ────────────────────────────────────────
        async function fetchPayments() {
            try {
                const res = await fetch('/superadmin/api/payments');
                const data = await res.json();
                const tbody = document.getElementById('paymentTableBody');
                
                if (data.payments.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:2rem;color:#64748b">No payment requests found.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.payments.map(p => {
                    const date = new Date(p.createdAt).toLocaleDateString();
                    const statusColor = p.status === 'approved' ? 'var(--success)' : (p.status === 'rejected' ? 'var(--danger)' : 'var(--warn)');
                    return `
                        <tr id="paymentrow-${p._id}">
                            <td>${date}</td>
                            <td>
                                <strong>${p.user ? p.user.username : 'Unknown'}</strong><br>
                                <span style="font-size:0.8rem;color:var(--muted)">${p.user ? p.user.email : ''}</span>
                            </td>
                            <td>
                                <span class="badge" style="background:#3b82f6;color:#fff">${p.planId ? p.planId.toUpperCase() : 'ELITE'}</span><br>
                                <strong style="color:var(--success)">₹${p.amount || 99}</strong>
                            </td>
                            <td style="font-family:monospace;letter-spacing:1px">${p.utr}</td>
                            <td><span class="badge" style="background:rgba(255,255,255,0.05);color:${statusColor};border:1px solid ${statusColor}">${p.status.toUpperCase()}</span></td>
                            <td style="text-align:right; display:flex; justify-content:flex-end; gap:0.5rem">
                                ${p.status === 'pending' ? `
                                <button class="btn btn-sm" style="background:var(--success);color:#fff" onclick="updatePayment('${p._id}', 'approve')">Approve</button>
                                <button class="btn btn-danger btn-sm" onclick="updatePayment('${p._id}', 'reject')">Reject</button>
                                ` : `<span style="color:var(--muted);font-size:0.8rem">Processed</span>`}
                            </td>
                        </tr>
                    `;
                }).join('');
                
                window.paymentsLoaded = true;
            } catch(e) {
                document.getElementById('paymentTableBody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:red">Failed to load payments.</td></tr>';
            }
        }

        // ── Update Payment Status ─────────────────────────────────
        async function updatePayment(id, action) {
            if (!confirm(`Are you sure you want to ${action} this payment?`)) return;
            
            try {
                const res = await fetch(`/superadmin/api/payments/${id}/${action}`, { method: 'PATCH' });
                const data = await res.json();
                if (res.ok) {
                    toast(data.message, '✅');
                    fetchPayments(); // refresh the table
                    if(action === 'approve') window.usersLoaded = false; // invalidate users cache
                } else {
                    toast(data.error || `Failed to ${action} payment`, '❌');
                }
            } catch(e) {
                toast('Network error while updating payment', '❌');
            }
        }

        // Initialize
        loadStats();

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('mobile-open');
            overlay.classList.toggle('active');
        }
    </script>
</body>
</html>
